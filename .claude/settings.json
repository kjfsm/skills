{
  "outputStyle": "kjfsm",
  "permissions": {
    "allow": [
      "Bash(scripts/check-invariants.sh)",
      "Bash(scripts/list-skills.sh)",
      "Bash(scripts/sync-project-skills.sh)",
      "Bash(scripts/sync-project-skills.sh --check)",
      "Bash(claude plugin validate:*)",
      "Bash(pnpm format:check)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/hooks/nudge-comment-check.sh\""
          }
        ]
      }
    ]
  }
}
